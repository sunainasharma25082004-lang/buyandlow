{
  "expo": {
    "name": "BuyLow",
    "slug": "buylow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buylow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buylowindia.ecommerce",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BuyLow uses your location to automatically fill your delivery address.",
        "NSCameraUsageDescription": "BuyLow needs access to your camera to take photos for product reviews.",
        "NSPhotoLibraryUsageDescription": "BuyLow needs access to your photo library to select photos for product reviews.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.buylowindia.ecommerce"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BuyLow to access your photos for product reviews.",
          "cameraPermission": "Allow BuyLow to use your camera for product review photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow BuyLow to use your live location to fill your delivery address automatically."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d15cbe2-7d31-41e7-b1f4-b5c3283eefc3"
      }
    },
    "owner": "vizeas001s-team"
  }
}
