{
  "cli": {
    "version": ">= 20.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://buylowindia.com/api",
        "EXPO_PUBLIC_GOOGLE_AUTH_ORIGIN": "https://buylowindia.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {},
      "env": {
        "EXPO_PUBLIC_API_URL": "https://buylowindia.com/api",
        "EXPO_PUBLIC_GOOGLE_AUTH_ORIGIN": "https://buylowindia.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}